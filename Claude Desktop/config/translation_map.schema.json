{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-architect-china.local/schemas/translation_map.schema.json",
  "title": "TranslationMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "enums",
    "style_rules",
    "term_mappings",
    "city_overrides",
    "validation_rules"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "default_locale",
        "default_city_context",
        "fallback_policy",
        "last_updated"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "default_locale": {
          "type": "string",
          "const": "zh-CN"
        },
        "default_city_context": {
          "$ref": "#/$defs/cityContext"
        },
        "fallback_policy": {
          "type": "string",
          "enum": [
            "gb_baseline_with_local_check_note"
          ]
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "discipline_context",
        "city_context",
        "confidence_flag",
        "mapping_status"
      ],
      "properties": {
        "category": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "discipline_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disciplineContext"
          }
        },
        "city_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cityContext"
          }
        },
        "confidence_flag": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confidenceFlag"
          }
        },
        "mapping_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingStatus"
          }
        }
      }
    },
    "style_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_mode",
        "unit_area_primary",
        "unit_land_secondary",
        "decimal_convention"
      ],
      "properties": {
        "identity_mode": {
          "type": "string",
          "enum": [
            "role_based_no_personal_name"
          ]
        },
        "unit_area_primary": {
          "type": "string",
          "const": "m2"
        },
        "unit_land_secondary": {
          "type": "string",
          "const": "mu"
        },
        "decimal_convention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ratio_digits",
            "area_digits",
            "height_digits"
          ],
          "properties": {
            "ratio_digits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "area_digits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "height_digits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        }
      }
    },
    "term_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/termMapping"
      }
    },
    "city_overrides": {
      "type": "object",
      "required": [
        "national"
      ],
      "propertyNames": {
        "$ref": "#/$defs/cityContext"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cityOverride"
      }
    },
    "validation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_mapping_keys",
        "confidence_score_range",
        "id_pattern"
      ],
      "properties": {
        "required_mapping_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_score_range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false
        },
        "id_pattern": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "authority",
        "approval_workflow",
        "role",
        "regulation",
        "planning_metric",
        "fire_life_safety",
        "accessibility",
        "sustainability",
        "contract_admin",
        "project_delivery",
        "document_submission",
        "typology"
      ]
    },
    "disciplineContext": {
      "type": "string",
      "enum": [
        "general",
        "planning",
        "architecture",
        "structure",
        "mep",
        "fire",
        "cost",
        "construction_admin"
      ]
    },
    "cityContext": {
      "type": "string",
      "enum": [
        "national",
        "beijing",
        "shanghai",
        "shenzhen",
        "guangzhou",
        "chengdu",
        "hangzhou"
      ]
    },
    "confidenceFlag": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "mappingStatus": {
      "type": "string",
      "enum": [
        "canonical",
        "contextual",
        "approximate"
      ]
    },
    "termMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "hk_term",
        "mainland_term",
        "discipline_context",
        "city_scope",
        "mapping_status",
        "confidence_flag",
        "confidence_score",
        "review_required",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tm-[0-9]{3}$"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "hk_term": {
          "type": "string",
          "minLength": 1
        },
        "mainland_term": {
          "type": "string",
          "minLength": 1
        },
        "discipline_context": {
          "$ref": "#/$defs/disciplineContext"
        },
        "city_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cityContext"
          },
          "uniqueItems": true
        },
        "mapping_status": {
          "$ref": "#/$defs/mappingStatus"
        },
        "confidence_flag": {
          "$ref": "#/$defs/confidenceFlag"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "cityOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disclaimer": {
          "type": "string"
        },
        "local_standard_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
